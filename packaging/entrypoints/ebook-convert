#!/bin/sh
set -eu
RUNTIME="${TALEBOOK_CALIBRE_PRIVATE_RUNTIME:-/usr/lib/talebook-calibre-runtime}"
export PYTHONHOME="$RUNTIME"
export PYTHONPATH="$RUNTIME/lib/python/site-packages"
export LD_LIBRARY_PATH="$RUNTIME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CALIBRE_STANDALONE_CONVERTER=1
export CALIBRE_STANDALONE_FORBID_QT=1
exec "$RUNTIME/bin/python3" "$RUNTIME/lib/python/ebook_convert_router.py" "$@"
